# ─── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio

# ─── Admin Panel ─────────────────────────────────────────────────────────────
# Password used to log into /admin
ADMIN_PASSWORD=your_admin_password_here

# ─── End-to-End Encryption ───────────────────────────────────────────────────
# Secret key used for AES-256-GCM encryption between frontend and backend API
# Must be the same on server (API_SECRET_KEY) and client (VITE_API_SECRET_KEY)
API_SECRET_KEY=your_encryption_secret_key_here
VITE_API_SECRET_KEY=your_encryption_secret_key_here
